---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% if page.layout and page.sitemap != false and page.hidden != true %}
<url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>
{% endif %}{% endfor %}
{% for post in site.posts %}{% unless post.sitemap == false or post.hidden %}
<url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
{% endunless %}{% endfor %}
</urlset>
